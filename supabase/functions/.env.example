# Edge Function secrets. Pushed with: supabase secrets set --env-file supabase/functions/.env
# This file is gitignored. Never commit it.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
APP_URL=
# Set to "false" to keep every workspace on the parent Twilio account (required on Twilio trial accounts)
TWILIO_USE_SUBACCOUNTS=true
# Reuse the parent account's approved regulatory bundle when a workspace buys a number (your own workspaces / testing)
TWILIO_SHARED_BUNDLE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_CREDITS_500=
STRIPE_PRICE_CREDITS_2000=
STRIPE_PRICE_CREDITS_10000=
STRIPE_METER_EVENT_NAME=
RESEND_API_KEY=
EMAIL_FROM="Decibel <oliver@hello.usedecibel.com>"
CRON_SECRET=
# founder support inbox at /private (password) and where new requests are emailed
PRIVATE_INBOX_PASSWORD=
SUPPORT_INBOX_EMAIL=
# free tools: TPS/CTPS (tpsapi.com), email verification (MillionVerifier); optional Cloudflare Turnstile secret
TPSAPI_KEY=
MILLIONVERIFIER_KEY=
TURNSTILE_SECRET=
# Search with AI (Claude)
ANTHROPIC_API_KEY=
# TPS/CTPS checks (Provero)
PROVERO_API_KEY=
